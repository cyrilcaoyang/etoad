{
  "version": 1,
  "formatters":
  {
    "simple":
    {
      "format": "%(asctime)s - %(message)s"
    }
  },
  "handlers":
  {
    "console":
    {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "simple",
      "stream": "ext://sys.stdout"
    },
    "file":
    {
      "class": "logging.FileHandler",
      "level": "DEBUG",
      "formatter": "simple",
      "filename": "EChem_Measurements.log",
      "mode": "a",
      "encoding": "utf-8"
    }
  },
  "loggers":
  {
    "EChem":
    {
      "level": "DEBUG",
      "handlers": ["console", "file"],
      "propagate": "no"
    }
  }
}
